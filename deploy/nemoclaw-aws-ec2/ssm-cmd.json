{
  "InstanceIds": ["i-085c26a0d1c7a8eb3"],
  "DocumentName": "AWS-RunShellScript",
  "TimeoutSeconds": 900,
  "Parameters": {
    "commands": [
      "cat > /tmp/fix-sandbox2.sh << 'SCRIPT_EOF'",
      "#!/bin/bash",
      "set -euo pipefail",
      "",
      "REPO=/opt/nemoclaw-src",
      "SANDBOX_NAME=my-assistant",
      "NEW_MODEL='nvidia/llama-3.3-nemotron-super-49b-v1'",
      "",
      "echo '=== 1. DELETE SANDBOX ==='",
      "openshell sandbox delete $SANDBOX_NAME 2>/dev/null || true",
      "sleep 3",
      "",
      "echo '=== 2. STAGE BUILD ==='",
      "BUILD_CTX=$(mktemp -d /tmp/nemoclaw-fix2-XXXXXX)",
      "cp $REPO/Dockerfile $BUILD_CTX/",
      "cp -r $REPO/nemoclaw $BUILD_CTX/nemoclaw",
      "cp -r $REPO/nemoclaw-blueprint $BUILD_CTX/nemoclaw-blueprint",
      "cp -r $REPO/scripts $BUILD_CTX/scripts",
      "rm -rf $BUILD_CTX/nemoclaw/node_modules",
      "bash $BUILD_CTX/scripts/clean-staged-tree.sh $BUILD_CTX/nemoclaw-blueprint 2>/dev/null || true",
      "",
      "# Patch model",
      "sed -i \"s|ARG NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b|ARG NEMOCLAW_MODEL=$NEW_MODEL|g\" $BUILD_CTX/Dockerfile",
      "sed -i \"s|ARG NEMOCLAW_PRIMARY_MODEL_REF=nvidia/nemotron-3-super-120b-a12b|ARG NEMOCLAW_PRIMARY_MODEL_REF=$NEW_MODEL|g\" $BUILD_CTX/Dockerfile",
      "",
      "# CRITICAL: Add dangerouslyDisableDeviceAuth at gateway level",
      "# Use a pattern without brackets to avoid escaping issues",
      "sed -i \"s|'auth': {'token': secrets.token_hex(32)}|'dangerouslyDisableDeviceAuth': True, 'auth': {'token': secrets.token_hex(32)}|g\" $BUILD_CTX/Dockerfile",
      "",
      "echo 'Verify patch:'",
      "grep -c 'dangerouslyDisableDeviceAuth' $BUILD_CTX/Dockerfile",
      "grep 'dangerouslyDisableDeviceAuth' $BUILD_CTX/Dockerfile",
      "",
      "echo '=== 3. BUILD ==='",
      "openshell sandbox create --from $BUILD_CTX/Dockerfile --name $SANDBOX_NAME --policy $REPO/nemoclaw-blueprint/policies/openclaw-sandbox.yaml -- nemoclaw-start &",
      "CREATE_PID=$!",
      "",
      "for i in $(seq 1 60); do",
      "  STATUS=$(openshell sandbox list 2>&1 | grep $SANDBOX_NAME || echo '')",
      "  if echo \"$STATUS\" | grep -q 'Ready'; then",
      "    echo \"Ready after ${i}x5s\"",
      "    break",
      "  fi",
      "  echo \"Waiting... ($i/60)\"",
      "  sleep 5",
      "done",
      "",
      "rm -rf $BUILD_CTX",
      "kill $CREATE_PID 2>/dev/null || true",
      "",
      "openshell sandbox list 2>&1",
      "",
      "echo '=== 4. WAIT + TEST ==='",
      "sleep 30",
      "openshell sandbox ssh-config $SANDBOX_NAME > /tmp/sb-ssh-config 2>&1",
      "",
      "echo '--- Config check ---'",
      "ssh -F /tmp/sb-ssh-config -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR openshell-$SANDBOX_NAME 'grep dangerouslyDisable /sandbox/.openclaw/openclaw.json 2>/dev/null' || echo 'grep-failed'",
      "",
      "echo '--- Gateway log ---'",
      "ssh -F /tmp/sb-ssh-config -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR openshell-$SANDBOX_NAME 'tail -5 /tmp/gateway.log 2>/dev/null' || echo 'no-log'",
      "",
      "echo '--- Agent test ---'",
      "ssh -F /tmp/sb-ssh-config -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR openshell-$SANDBOX_NAME 'timeout 30 openclaw agent --agent main --local --session-id fixed2 -m \"hola\" 2>&1' || echo 'agent-failed'",
      "",
      "echo '=== 5. RESTART SERVICE ==='",
      "sudo systemctl restart nemoclaw-aux && sleep 2 && sudo systemctl is-active nemoclaw-aux",
      "SCRIPT_EOF",
      "chmod +x /tmp/fix-sandbox2.sh",
      "sudo -u ubuntu -i bash /tmp/fix-sandbox2.sh"
    ]
  }
}
